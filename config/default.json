{
  "server": {
    "host": "0.0.0.0",
    "port": 8080,
    "max_clients": 4
  },
  "webrtc": {
    "ice_servers": [
      {
        "urls": "stun:stun.l.google.com:19302"
      }
    ],
    "max_bitrate": 15000000,
    "min_bitrate": 500000
  },
  "encoding": {
    "codec": "h264",
    "hardware_acceleration": true,
    "software_encoder": "x264",
    "fallback_to_software": true,
    "gop_size": 60,
    "b_frames": 3,
    "target_fps": 60,
    "bitrate": 5000000,
    "max_b_frames": 10,
    "min_b_frames": 0
  },
  "capture": {
    "fps": 60,
    "display_index": 0
  },
  "metrics": {
    "enabled": true,
    "export_interval_ms": 1000
  }
}
